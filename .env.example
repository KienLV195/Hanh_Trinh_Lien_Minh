# Backend
HOST=0.0.0.0
PORT=3001
# Optional. Set this only when the production frontend uses a different origin.
WEB_ORIGIN=http://localhost:5173
PROTOCOL_VERSION=1.0.0

# Optional in production: absolute directory containing the Vite build
STATIC_DIR=

# Frontend (Vite exposes variables prefixed with VITE_)
# Set both URLs when the frontend and backend use different production origins.
# If omitted from a production build, the browser uses its current origin.
VITE_SERVER_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_PROTOCOL_VERSION=1.0.0
