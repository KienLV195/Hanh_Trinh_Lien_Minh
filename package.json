{
  "name": "hanh-trinh-lien-minh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "dev": "pnpm build:packages && concurrently -n web,server -c blue,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter @htlm/web dev",
    "dev:server": "pnpm --filter @htlm/server dev",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" -r build",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter \"./packages/*\" -r typecheck && pnpm --filter \"./apps/*\" -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
